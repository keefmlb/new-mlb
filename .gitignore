# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Generated data — large, rebuilt by pipeline scripts
data/cache/
data/games/
data/weather/

# Odds + bets: mostly regenerable EXCEPT the bet log and the closing-line
# history — those are small, append-only, and irreplaceable (every tuned
# constant traces back to them). Keep them in version control: after pulling
# this change, run `git add data/bets/bet_log.json data/odds/closing_lines.csv`
# on the machine that has them.
data/odds/*
!data/odds/closing_lines.csv
!data/odds/closing_props.csv
!data/odds/replay_archive.csv
data/bets/*
!data/bets/bet_log.json

# Trained model binaries — rebuilt by train_combined.py / train_props.py
data/models/*.joblib

# Keep hand-edited config files that live in data/models/
!data/models/stat_reliability.json
!data/models/dispersion.json

# Secrets / environment
.env
*.env

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
.claude/settings.local.json
_streamlit_check.log
_*.py
_*.log
*.refit_backup

# Secrets — never commit API keys
data/secrets.json
.secrets

# Temporary model snapshots taken before cutoff-training experiments
data/models_backup_prereplay/
